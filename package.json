{
  "name": "critical-point-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint --cache --max-warnings 0 .",
    "format": "prettier --write src/styles",
    "format:check": "prettier --check src/styles",
    "test": "node --test scripts/unit-tests.mjs scripts/smoke-test.mjs \"tests/unit/**/*.test.mjs\"",
    "test:coverage": "node scripts/check-coverage.mjs",
    "check:css": "node scripts/check-css-tokens.mjs",
    "check:css-structure": "node scripts/check-css-structure.mjs",
    "check:encoding": "node scripts/check-utf8.mjs",
    "check:text": "node scripts/check-text-integrity.mjs",
    "check:plain-language": "node scripts/check-plain-language.mjs",
    "check:graph": "node scripts/validate-game-graph.mjs",
    "check:dialogue": "node scripts/check-dialogue.mjs",
    "check:balance": "node scripts/check-balance.mjs",
    "check:pressure": "node scripts/report-gauntlet-loop.mjs",
    "check:endings": "node scripts/check-endings.mjs",
    "report:endings": "node scripts/check-endings.mjs --report",
    "check:art": "node scripts/check-art-budget.mjs",
    "build:art": "node scripts/build-art-variants.mjs",
    "build:critical": "node scripts/build-critical-css.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "raise:gains": "node scripts/raise-choice-gains.mjs",
    "check:views": "node scripts/check-view-contracts.mjs",
    "check:constants": "node scripts/check-shared-constants.mjs",
    "check:runtime-budget": "node scripts/check-runtime-budget.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:export-schema": "node scripts/check-export-schema.mjs",
    "check:test-storage": "node scripts/check-test-storage.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:visual-baselines": "node scripts/check-visual-baselines.mjs",
    "check:node": "node scripts/check-node-version.mjs",
    "check:grants": "node scripts/check-grants.mjs",
    "check:canon": "node scripts/check-canon.mjs",
    "check:types": "tsc -p jsconfig.json",
    "check:specs": "node scripts/run-e2e.mjs --list",
    "check:deploy:offline": "node scripts/check-deploy.mjs --offline",
    "test:runtime": "node scripts/run-e2e.mjs --runtime --preview",
    "test:runtime:dev": "node scripts/run-e2e.mjs --runtime",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:performance": "node scripts/run-e2e.mjs --preview tests/performance.spec.js --project=chromium --workers=1",
    "test:e2e:webkit": "node scripts/run-e2e.mjs --preview --webkit",
    "test:e2e:full": "node scripts/run-e2e.mjs --full",
    "test:e2e:season": "node scripts/run-e2e.mjs --season",
    "test:e2e:preview": "node scripts/run-e2e.mjs --preview",
    "test:visual": "node scripts/run-e2e.mjs --grep @visual tests/visual-regression.spec.js --project=chromium",
    "test:visual:docker": "node scripts/run-e2e.mjs --docker --grep @visual tests/visual-regression.spec.js --project=chromium",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:quick": "npm run verify:static && npm run check:specs && npm run build:e2e && npm run check:bundle && npm run check:deploy:offline && npm run test:runtime && npm run test:e2e:preview && npm run test:performance",
    "verify:e2e": "npm run test:e2e",
    "verify": "npm run verify:quick && npm run verify:e2e",
    "verify:full": "npm run verify && npm run test:e2e:full && npm run test:e2e:season"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "espree": "^11.2.0",
    "fontverter": "2.0.0",
    "globals": "^17.13.0",
    "pretendard": "^1.3.9",
    "prettier": "^3.9.9",
    "subset-font": "^2.9.0",
    "supabase": "2.119.0",
    "typescript": "7.0.2",
    "vite": "^7.0.0",
    "yaml": "^2.9.1"
  }
}
