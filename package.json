{
  "name": "critical-point-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/smoke-test.mjs",
    "test:runtime": "node scripts/run-e2e.mjs --runtime",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:full": "node scripts/run-e2e.mjs --full",
    "verify": "npm test && npm run build && npm run test:runtime && npm run test:e2e",
    "verify:full": "npm run verify && npm run test:e2e:full"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0"
  }
}
