{
  "name": "critical-point-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write src/styles",
    "format:check": "prettier --check src/styles",
    "test": "node scripts/unit-tests.mjs && node scripts/smoke-test.mjs",
    "check:css": "node scripts/check-css-tokens.mjs",
    "check:css-structure": "node scripts/check-css-structure.mjs",
    "check:encoding": "node scripts/check-utf8.mjs",
    "check:text": "node scripts/check-text-integrity.mjs",
    "check:graph": "node scripts/validate-game-graph.mjs",
    "check:dialogue": "node scripts/check-dialogue.mjs",
    "check:balance": "node scripts/check-balance.mjs",
    "check:endings": "node scripts/check-endings.mjs",
    "check:art": "node scripts/check-art-budget.mjs",
    "build:art": "node scripts/build-art-variants.mjs",
    "check:views": "node scripts/check-view-contracts.mjs",
    "test:runtime": "node scripts/run-e2e.mjs --runtime",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:full": "node scripts/run-e2e.mjs --full",
    "test:visual": "node scripts/run-e2e.mjs --grep @visual tests/visual-regression.spec.js --project=chromium",
    "verify:static": "npm run lint && npm run format:check && npm test && npm run check:encoding && npm run check:text && npm run check:css && npm run check:css-structure && npm run check:graph && npm run check:dialogue && npm run check:balance && npm run check:endings && npm run check:art && npm run check:views",
    "verify:quick": "npm run verify:static && npm run build && npm run test:runtime",
    "verify:e2e": "npm run test:e2e",
    "verify": "npm run verify:quick && npm run verify:e2e",
    "verify:full": "npm run verify && npm run test:e2e:full"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "espree": "^11.2.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "^7.0.0"
  }
}
