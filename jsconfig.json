{
  "//": "npm run check:types. Only the files listed below are type-checked (plus whatever they import). Each one passed as-is when it joined; add a module once it does too, never loosen a check to get one in.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "types": [],
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "files": [
    "src/gameConstants.js",
    "src/privacyText.js",
    "src/ranking.js",
    "src/responsiveArt.js",
    "src/riskLogic.js",
    "src/state/diagnosticUtils.js",
    "src/state/payloadSchemas.js",
    "src/state/telemetryQueuePolicy.js",
    "src/state/trace.js"
  ]
}
