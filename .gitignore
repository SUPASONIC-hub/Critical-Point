node_modules/
dist/
test-results/
playwright-report/
debug.log
# Vite reads .env, .env.local, .env.<mode> and .env.<mode>.local, and the README
# tells a developer to create .env.local -- which `.env` alone did not cover.
# The two that are committed hold placeholders, not keys.
.env*
!.env.example
!.env.e2e
.DS_Store
.claude/worktrees/

# Windows matches this case-insensitively, so the public icon needs the negation.
Profile.jpg
!public/profile.jpg

# Reference notes dropped in the working tree -- research input, not project
# files. Anchored to the root so docs/ is unaffected, and written as a rule
# rather than one filename so the next note does not have to be remembered.
/*.md
!/README.md

# Output of the free-text analysis script, which was removed with the
# free-text input. Still ignored: a checkout that ran it holds player sentences.
analysis-out/

# `eslint --cache` (npm run lint) keeps its per-file results here.
.eslintcache
# `npm run test:coverage` output, if a reporter is pointed at a file.
coverage/

# Visual baselines are recorded in the pinned Playwright container only (npm run
# test:visual:docker, or the Visual Regression dispatch). A set rendered on a
# Windows desktop is never compared by anything, so it is never committed.
tests/visual-regression.spec.js-snapshots/*-win32.png
tests/visual-regression.spec.js-snapshots/*-darwin.png
