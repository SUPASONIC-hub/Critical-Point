VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ENABLE_DEBUG_TOOLS=false
# Live LLM reading of free-input cards. Off by default: it needs
# ANTHROPIC_API_KEY on the analyze-free-text edge function. The offline
# runner (npm run analyze:free-text) needs neither.
VITE_ENABLE_LIVE_ANALYSIS=false
