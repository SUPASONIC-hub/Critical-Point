-- DRAFT (2026-10-25), kept as `.sql.draft` so nothing applies it: merging a
-- `.sql` to main applies it within a minute, before the client deploys. It
-- ships with the next ranking reset after RULES_MARK 3's (the user,
-- 2026-10-24, 대조표 질문 1 (1): the score's 판 읽기 axis goes out with the
-- reset after #224, measured with the bots). On the merge day the user is
-- asked first; then the file is renamed to `.sql` and re-dated to follow the
-- last migration on main -- after 20261102020000_season_score_case_mean,
-- whose `ranking_run_summary` this one replaces.
--
-- C-1(1), the user, 2026-10-25 「전부 1」: each case's burst score gives 0.2
-- to 판 읽기 -- the C-12 index the case close prints (「벽을 본 사람의
-- N%」): the vault the case's bare hand kept against a hand that sees the
-- wall on the same boards -- and the six axes before it keep their ratios at
-- 0.8 of what they were (consistency 0.28 -> 0.224, 관점 전환 0.2 -> 0.16,
-- reflection 0.2 -> 0.16, pressure 0.16 -> 0.128, rhythm 0.08 -> 0.064,
-- challenge 0.08 -> 0.064). The page scores each case (getGameplayStats,
-- src/gameLogic.js) and writes the axis in the case row's summary as
-- `readingScore`; the server never scored a case and does not start here
-- (the checker, src/rankingRecheck.js, works each case's score out again from
-- its log, the axis too, and holds each window's read to its replay).
--
-- What changes for the server, in `ranking_run_summary` only, against
-- 20261102020000's (every other line is that one's, word for word):
--
--   1. The season's 관점 전환 swap weighs 0.16, not 0.2: each row's own
--      `cognitionScore` counted 0.16 of its score, so the score is
--      (25 * sum of scores + 4 * (cases * season's - sum of the rows'))
--      / (25 * cases) -- 0.16 = 4 / 25, whole numbers until the division, as
--      the client's getSeasonScore (src/seasonScore.js) writes it. The plain
--      mean, for a run with a row that has no count, is as it was.
--   2. A run with a case row whose `readingScore` is not a whole number from
--      0 to 100 is refused, 'older-score runs are not ranked', after the
--      score checks: that case was scored on the six weights before, and a
--      season begun before this build and finished after it is never ranked
--      (the client's queue drops the row as it drops an older table's,
--      BEAT_TABLE_REFUSAL in src/state/telemetryBatch.js). In the minute
--      between this migration and the client's deploy, the build before still
--      writes no `readingScore`, and its seasons are refused the same way.
--
-- 3. The ranking starts over. A score with the axis does not compare with
--    one without it. In the 11-30 deploy (integration-1130) that is the one
--    reset of the day, RULES_MARK 4's (20261103000000), which comes after
--    this file and the hall of fame: this file no longer deletes on its own,
--    so the ranking is emptied once. The client's own ranking is emptied by a
--    new storage key (v11; the best row of v9 is kept as a personal best,
--    src/personalBests.js). Shipped without RULES_MARK 4, this file would
--    need its `delete ... where case_id = 'season-final'` back.
--
-- check:grants: once this is a `.sql` the block "the season score has the
-- 판 읽기 axis" runs (a run with a row closed before the axis is refused, and
-- the server's number is the client's on the same rows); while it is a draft
-- the block says so, and the client's getSeasonScore already writes the 0.16
-- swap, so 20261102020000 must not be renamed without this one.
--
-- `create or replace` keeps the part's grants; they are restated anyway, and
-- every attribute is set again.

create or replace function public.ranking_run_summary(p_run_id text, p_session_id text)
returns jsonb
language plpgsql
security invoker
set search_path = public
as $$
declare
  v_final_summary jsonb;
  v_score_text text;
  v_week text;
  v_cases integer;
  v_scored integer;
  v_sum numeric;
  v_mean numeric;
  v_mixes integer;
  v_own integer;
  v_read integer;
  v_season_mix jsonb;
  v_season integer;
begin
  select s.summary into v_final_summary
    from public.playtest_sessions s
   where s.run_id = p_run_id and s.case_id = 'final' and s.session_id = p_session_id
   limit 1;
  v_final_summary := public.ranking_public_summary(v_final_summary);
  v_score_text := v_final_summary->>'burstScore';
  if v_score_text is null or v_score_text !~ '^[0-9]{1,3}([.][0-9]{1,6})?$' or v_score_text::numeric > 100 then
    raise exception 'invalid season ranking score';
  end if;
  if coalesce(v_final_summary->>'rank', '') not in ('S', 'A', 'B', 'C') then
    raise exception 'invalid season ranking rank';
  end if;
  -- The season's score: the mean of its case rows' scores. Each score is
  -- tested before it is cast, inside one CASE, since SQL does not promise
  -- the order of an `and`. Beside it, each row's 관점 전환 as its
  -- `cognitionMix` makes it (null when that is not a count), and whether
  -- the row carries its 판 읽기 axis (`readingScore`, a whole number from 0
  -- to 100), which a row closed before the axis does not; tested before it
  -- is cast, the same way.
  select count(*)::integer,
         count(c.score)::integer,
         sum(c.score),
         count(c.spread)::integer,
         sum(c.spread)::integer,
         count(*) filter (where c.read_ok)::integer
    into v_cases, v_scored, v_sum, v_mixes, v_own, v_read
    from (
      select case
               when t.score_text ~ '^[0-9]{1,3}([.][0-9]{1,6})?$' then
                 case when t.score_text::numeric <= 100 then t.score_text::numeric end
             end as score,
             public.ranking_cognition_spread(t.mix) as spread,
             case
               when jsonb_typeof(t.reading) = 'number' and t.reading::text ~ '^[0-9]{1,3}$' then
                 t.reading::text::integer <= 100
               else false
             end as read_ok
        from (
          select public.ranking_public_summary(s.summary)->>'burstScore' as score_text,
                 s.summary->'cognitionMix' as mix,
                 s.summary->'readingScore' as reading
            from public.playtest_sessions s
           where s.run_id = p_run_id
             and s.case_id = any(public.season_case_ids())
        ) t
    ) c;
  if v_cases < cardinality(public.season_case_ids()) or v_scored < v_cases or v_sum is null then
    raise exception 'invalid season ranking score';
  end if;
  -- A case scored before the 판 읽기 axis was scored on other weights: the
  -- season is not ranked, as a case of an older table is not.
  if v_read < v_cases then
    raise exception 'older-score runs are not ranked';
  end if;
  -- 관점 전환 read off the whole season: every row's count summed, when every
  -- row has one, and that sum's 관점 전환 put in place of the rows' own.
  v_season := null;
  if v_mixes = v_cases then
    select jsonb_object_agg(m.kind, m.n)
      into v_season_mix
      from (
        select e.key as kind, sum(e.value::text::integer) as n
          from public.playtest_sessions s,
               jsonb_each(s.summary->'cognitionMix') e
         where s.run_id = p_run_id
           and s.case_id = any(public.season_case_ids())
         group by e.key
      ) m;
    v_season := public.ranking_cognition_spread(coalesce(v_season_mix, '{}'::jsonb));
  end if;
  if v_season is null then
    v_mean := round(least(greatest(v_sum / v_cases, 0), 100));
  else
    v_mean := round(least(greatest((25 * v_sum + 4 * (v_cases * v_season - v_own)) / (25 * v_cases), 0), 100));
  end if;
  v_final_summary := v_final_summary || jsonb_build_object(
    'burstScore', v_mean,
    'momentumScore', v_mean,
    'rank', public.ranking_rank_for(v_mean),
    'momentumTier', public.ranking_tier_for(v_mean)
  );
  v_week := public.ranking_run_week(p_run_id);
  if v_week is not null then
    v_final_summary := v_final_summary || jsonb_build_object('week', v_week);
  end if;
  return v_final_summary;
end;
$$;

-- The grants as 20261014000000:358,367 wrote them.
revoke all on function public.ranking_run_summary(text, text) from public, anon, authenticated;
grant execute on function public.ranking_run_summary(text, text) to service_role;

notify pgrst, 'reload schema';
