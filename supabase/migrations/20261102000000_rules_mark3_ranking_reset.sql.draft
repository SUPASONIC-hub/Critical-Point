-- DRAFT (2026-10-21), kept as `.sql.draft` so nothing applies it: merging a
-- `.sql` to main applies it within a minute, before the client deploys. It
-- ships with RULES_MARK 3 in the same pull request, and only if the verdict
-- on 2026-W47 (11-23) is to make the test week's table the table. On the
-- merge day the user is asked first; then the file is renamed to `.sql`,
-- re-dated to follow the last migration on main, and check:grants replays it
-- (scripts/check-grants.mjs judges the newest ranking reset by what it leaves
-- and asks for the mark it sets).
--
-- RULES_MARK 3. B3's audit and B2's links, played as 2026-W47's test week
-- (`audit-cascade`, 20261021010000, moved to W47 by 20261022010000), become
-- rules of the table from prologue 04, and from the first case under NEW
-- GAME+: a cash pushed once and closed
-- below 40 fills the audit, and four marks at a case's close take a quarter
-- of what it moves to the vault; a card that burned 8 or more of one resource
-- pulls a later board's wall 6 closer. Two things follow, as in
-- 20261020010000; the third that file did is not needed.
--
-- 1. The ranking starts over. A score from a table without the audit and the
--    links does not compare with one from this table. The same reset as the
--    eight before it, the same statement and nothing wider: only
--    `season-final` rows are ranking rows -- the ordinary board's and the
--    event weeks' (`week`, 20261021000000) alike -- and per-case telemetry
--    stays where it is. The client's own ranking is emptied the same way, by
--    a new storage key (v10). This is the one reset for the change of table.
--    The hall of fame (`hall_of_fame`, `hall_of_fame_boards`, D2) is not
--    touched: it is what stays when the ranking is emptied, and the daily
--    check settles the last table's board on its first write after this.
--
-- 2. A season from the table before does not come back: the ranking refuses
--    a `season-final` row for a run with any case row whose `tableRules` (in
--    its `dynamics`) is not a number of 3 or more. Every build from this one
--    writes 3 (`createRunSummary`); the builds of 2026-10-20 to this one wrote
--    2, and 2026-W47's seasons are among them. Only that number changes in
--    `ranking_check_run_marks`; its three blocks are otherwise the ones
--    20261020010000 wrote, word for word.
--
--    What this costs: a season begun before this table and finished after it
--    is never ranked, whatever it scores from here on. In the minute between
--    this migration and the client's deploy, the build before still sends
--    `tableRules: 2`, and its seasons are refused the same way.
--
-- 3. Nothing here touches `playtest_sessions_dynamics_shape`: the mark's key
--    is already there (a number when present, 20261020010000), the last
--    definition (20261021000000's) is left as it is, and the save's version 4
--    and the links it carries never reach the server.
--
-- 4. The season's score changes with this table's ranking, in a file of its
--    own: 20261102020000_season_score_case_mean (a draft too, the user's
--    answer of 2026-10-22, Q7 (1)) makes the published score the mean of the
--    run's case scores. It is renamed with this one and sorts after it, so
--    the emptied ranking takes its first row on the mean.
--
-- The part first, so the ranking is never empty and unguarded. `create or
-- replace` keeps the part's grants, and they are restated anyway; every
-- attribute is set again, since `create or replace` drops one left out.

create or replace function public.ranking_check_run_marks(p_run_id text)
returns void
language plpgsql
security invoker
set search_path = public
as $$
begin
  -- A case closed in story mode carries `assistStory: true` in its own
  -- row's summary, and one such case keeps the whole season off the
  -- ranking. Read from the run's rows; a plain exception, since no later
  -- attempt can change what the run was.
  if exists (
    select 1 from public.playtest_sessions s
    where s.run_id = p_run_id
      and s.case_id = any(public.season_case_ids())
      and s.summary->'assistStory' = 'true'::jsonb
  ) then
    raise exception 'story-mode runs are not ranked';
  end if;
  -- A case closed at the table that paid for a press timed to the beat has
  -- no `logicStreak` in its row's `dynamics`; a case closed at this one
  -- always has, as a number. One such case keeps the whole season off the
  -- ranking, read from the run's rows like the story mark above, and a
  -- row with no `dynamics` is such a row. `is not true`, so a missing
  -- key, a missing object and a value of another type all read alike.
  if exists (
    select 1 from public.playtest_sessions s
    where s.run_id = p_run_id
      and s.case_id = any(public.season_case_ids())
      and (jsonb_typeof(s.dynamics->'logicStreak') = 'number') is not true
  ) then
    raise exception 'beat-table runs are not ranked';
  end if;
  -- A case closed at a table before this one has no `tableRules` in its
  -- row's `dynamics`, or one below 3 (2 is the day-ten table of
  -- 2026-10-20, and 2026-W47's test week); a case closed at this one
  -- always has, as a number of 3 or more. One such case keeps the whole
  -- season off the ranking, read from the run's rows like the two marks
  -- above. `is not true`, so a missing key, a missing object, a value of
  -- another type and a smaller number all read alike. The `case` keeps
  -- the cast off a stored row whose key is not a number.
  if exists (
    select 1 from public.playtest_sessions s
    where s.run_id = p_run_id
      and s.case_id = any(public.season_case_ids())
      and (case when jsonb_typeof(s.dynamics->'tableRules') = 'number'
                then (s.dynamics->>'tableRules')::numeric >= 3 end) is not true
  ) then
    raise exception 'older-table runs are not ranked';
  end if;
end;
$$;

revoke all on function public.ranking_check_run_marks(text) from public, anon, authenticated;
grant execute on function public.ranking_check_run_marks(text) to service_role;

delete from public.playtest_sessions where case_id = 'season-final';

notify pgrst, 'reload schema';
