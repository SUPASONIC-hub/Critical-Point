# The backend the production-build tests talk to: an address that exists only
# as a Playwright route (tests/helpers/network.js). `npm run build:e2e` reads
# this file, so the build the @prod tier plays has telemetry, the ranking, the
# board and online save switched on, as the deployed one does. Not a secret.
VITE_SUPABASE_URL=https://e2e.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-anon-key
VITE_ENABLE_DEBUG_TOOLS=false
