# The web build the iOS shell copies in (npm run build:web); made again on every sync.
dist-app/

# Bubblewrap writes the Android project next to twa-manifest.json
# (`bubblewrap update`). twa-manifest.json is the source; the project is made
# again from it, and the keystore never leaves the machine it was made on.
twa/*
!twa/twa-manifest.json
!twa/check-twa.mjs
*.keystore
*.jks
