root = true

# Matches what the repository already holds: UTF-8 (`npm run check:encoding`),
# LF (.gitattributes), two-space indentation.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
